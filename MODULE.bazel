module(
    name = "rules_heir",
    version = "0.0.3",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.18")

# hermetic LLVM toolchain (for C++ compiler and linker)
bazel_dep(name = "llvm", version = "0.7.8")

register_toolchains("@llvm//:all")

repos = use_extension("@rules_heir//heir:extensions.bzl", "heir_repositories")
use_repo(
    repos,
    "heir_linux_x86_64",
)

register_toolchains(
    "@rules_heir//heir:heir_linux_x86_64_toolchain",
)
